<Page
    x:Class="MemoryTimeline.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="24" MaxWidth="800">
            <!-- Header -->
            <StackPanel Spacing="8">
                <TextBlock Text="Settings"
                          Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock Text="Configure your Memory Timeline experience"
                          Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Appearance Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Appearance"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="Theme"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox x:Name="ThemeComboBox"
                             ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                             SelectedItem="{x:Bind ViewModel.SelectedTheme, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Select theme"/>
                    <TextBlock Text="Choose your preferred color theme"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Timeline Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Timeline"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="Default Zoom Level"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox x:Name="ZoomLevelComboBox"
                             ItemsSource="{x:Bind ViewModel.ZoomLevelOptions}"
                             SelectedItem="{x:Bind ViewModel.SelectedZoomLevel, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Select zoom level"/>
                    <TextBlock Text="Initial zoom level when viewing the timeline"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- AI/LLM Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="AI &amp; Language Models"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="LLM Provider"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox x:Name="LlmProviderComboBox"
                             ItemsSource="{x:Bind ViewModel.LlmProviderOptions}"
                             SelectedItem="{x:Bind ViewModel.LlmProvider, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Select provider"/>
                    <TextBlock Text="Anthropic (Claude cloud) or any OpenAI-compatible endpoint"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Model"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBox Text="{x:Bind ViewModel.LlmModel, Mode=TwoWay}"
                            PlaceholderText="Enter model name"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Specific model version to use for event extraction"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="LLM Base URL"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBox x:Name="LlmBaseUrlBox"
                            Text="{x:Bind ViewModel.LlmBaseUrl, Mode=TwoWay}"
                            PlaceholderText="http://localhost:11434/v1"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="For Ollama / LM Studio / vLLM — used when the provider is OpenAI-compatible"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="API Key"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <PasswordBox x:Name="ApiKeyBox"
                                Password="{x:Bind ViewModel.ApiKey, Mode=TwoWay}"
                                PlaceholderText="Enter API key"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Your API key will be stored securely"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Embedding Provider"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox x:Name="EmbeddingProviderComboBox"
                             ItemsSource="{x:Bind ViewModel.EmbeddingProviderOptions}"
                             SelectedItem="{x:Bind ViewModel.SelectedEmbeddingProvider, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"
                             PlaceholderText="Select embedding provider"/>
                    <TextBlock Text="Local runs entirely on-device (all-MiniLM-L6-v2, 384 dimensions, no key); OpenAI needs an API key"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Embedding API Key (OpenAI)"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <PasswordBox x:Name="EmbeddingApiKeyBox"
                                Password="{x:Bind ViewModel.EmbeddingApiKey, Mode=TwoWay}"
                                PlaceholderText="Enter OpenAI API key for embeddings"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Only needed when the embedding provider is OpenAI (cloud)"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <InfoBar IsOpen="{x:Bind ViewModel.ShowReEmbedWarning, Mode=OneWay}"
                        Severity="Warning"
                        IsClosable="False"
                        Title="Embedding provider changed"
                        Message="Existing connections were computed with a different model — re-embed to keep similarity working"/>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.ReEmbedAllCommand}"
                           IsEnabled="{x:Bind ViewModel.IsReEmbedding, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                            <TextBlock Text="Re-embed all events"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Cancel"
                           Command="{x:Bind ViewModel.CancelReEmbedCommand}"
                           Visibility="{x:Bind ViewModel.IsReEmbedding, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsReEmbedding, Mode=OneWay}"
                                 Width="20" Height="20"
                                 VerticalAlignment="Center"
                                 Visibility="{x:Bind ViewModel.IsReEmbedding, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.ReEmbedStatusMessage, Mode=OneWay}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"/>

                <Border Height="1"
                       Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,8"/>

                <TextBlock Text="{x:Bind ViewModel.PrivacySummary}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"/>

                <TextBlock Text="{x:Bind ViewModel.LlmUsageSummary, Mode=OneWay}"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- Audio Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Audio Recording"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <!-- Microphone picker: persisted as audio_input_device_id on Save and
                     read by QueueViewModel when a recording starts. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Microphone"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="AudioInputDeviceComboBox"
                                 Grid.Column="0"
                                 ItemsSource="{x:Bind ViewModel.AudioInputDevices}"
                                 DisplayMemberPath="Name"
                                 SelectedItem="{x:Bind ViewModel.SelectedAudioInputDevice, Mode=TwoWay}"
                                 HorizontalAlignment="Stretch"
                                 PlaceholderText="System default"/>
                        <Button Grid.Column="1"
                               Content="Refresh"
                               Command="{x:Bind ViewModel.RefreshAudioInputDevicesCommand}"
                               ToolTipService.ToolTip="Re-scan audio input devices"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.AudioDeviceStatus, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>
                    <TextBlock Text="Used for new recordings on the Queue page. 'System default' follows the Windows default input device. Applied after Save Settings."
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>
                </StackPanel>

                <!-- The format is fixed, not a setting: the earlier Sample Rate /
                     Bits Per Sample boxes were decorative (never read by the
                     recorder) and Whisper needs exactly this format. -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Recording format"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.RecordingFormatSummary}"
                              Style="{StaticResource BodyTextBlockStyle}"
                              IsTextSelectionEnabled="True"/>
                    <TextBlock Text="Fixed on purpose: the local Whisper transcription engine takes exactly 16 kHz, 16-bit, mono PCM, so sample rate and bit depth are not configurable. Audio imported in other formats is converted on its way into the queue."
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>

            <!-- Sync Section (iOS companion Phase 1) -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Sync"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="8">
                    <ToggleSwitch Header="Sync with companion devices"
                                 IsOn="{x:Bind ViewModel.SyncEnabled, Mode=TwoWay}"
                                 OnContent="On"
                                 OffContent="Off"/>
                    <TextBlock Text="Pull captures from your other devices and publish local changes"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Server URL"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <TextBox Text="{x:Bind ViewModel.SyncServerUrl, Mode=TwoWay}"
                            PlaceholderText="https://..."
                            IsEnabled="{x:Bind ViewModel.IsSyncPaired, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                            HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Address of your Memory Line sync service (unpair to change)"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Pairing Code"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <PasswordBox Password="{x:Bind ViewModel.SyncPairingCode, Mode=TwoWay}"
                                PlaceholderText="Enter the one-time pairing code"
                                IsEnabled="{x:Bind ViewModel.IsSyncPaired, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}"
                                HorizontalAlignment="Stretch"/>
                    <TextBlock Text="Shown by the sync service when you add a device; it is never stored"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ColumnSpacing>8</Grid.ColumnSpacing>

                    <Button Grid.Column="0"
                           Command="{x:Bind ViewModel.PairDeviceCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsSyncPaired, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE71B;" FontSize="20"/>
                            <TextBlock Text="Pair Device" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                           Command="{x:Bind ViewModel.UnpairDeviceCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsSyncPaired, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE711;" FontSize="20"/>
                            <TextBlock Text="Unpair" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                           Command="{x:Bind ViewModel.SyncNowCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsSyncPaired, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE895;" FontSize="20"/>
                            <TextBlock Text="Sync Now" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Run.Text is not a dependency property in WinUI, so the dynamic
                     device name uses its own TextBlock for the OneWay binding. -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                           Visibility="{x:Bind ViewModel.IsSyncPaired, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="Paired as:"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.SyncDeviceDisplayName, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Spacing="8">
                    <ToggleSwitch Header="Process synced recordings automatically"
                                 IsOn="{x:Bind ViewModel.SyncAutoProcess, Mode=TwoWay}"
                                 OnContent="On"
                                 OffContent="Off"/>
                    <TextBlock Text="Transcribe and extract events from recordings that arrive from other devices"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.SyncStatusText, Mode=OneWay}"
                          Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"/>

                <TextBlock Text="Sync tokens are stored in the local settings database on this PC."
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Export/Import Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Export &amp; Import"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <TextBlock Text="Export your timeline data to different formats"
                          Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <!-- Export Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ColumnSpacing>8</Grid.ColumnSpacing>

                    <Button Grid.Column="0"
                           Command="{x:Bind ViewModel.ExportToJsonCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsExporting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8B7;" FontSize="20"/>
                            <TextBlock Text="Export JSON" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                           Command="{x:Bind ViewModel.ExportToCsvCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsExporting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A5;" FontSize="20"/>
                            <TextBlock Text="Export CSV" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="2"
                           Command="{x:Bind ViewModel.ExportToMarkdownCommand}"
                           HorizontalAlignment="Stretch"
                           IsEnabled="{x:Bind ViewModel.IsExporting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                        <StackPanel Spacing="4">
                            <FontIcon Glyph="&#xE8A4;" FontSize="20"/>
                            <TextBlock Text="Export MD" Style="{StaticResource CaptionTextBlockStyle}"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Export Status -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsExporting, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ProgressBar Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}"
                                Maximum="100"
                                IsIndeterminate="{x:Bind ViewModel.IsExporting, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.ExportStatusMessage, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Height="1"
                       Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,8"/>

                <!-- Import Section -->
                <TextBlock Text="Import timeline data from JSON"
                          Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Command="{x:Bind ViewModel.ImportFromJsonCommand}"
                       HorizontalAlignment="Stretch"
                       IsEnabled="{x:Bind ViewModel.IsImporting, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                        <TextBlock Text="Import from JSON"/>
                    </StackPanel>
                </Button>

                <!-- Import Status -->
                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsImporting, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}"
                                 Width="24" Height="24"/>
                    <TextBlock Text="{x:Bind ViewModel.ImportStatusMessage, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Data Management Section (F12: backups, restore, cleanup) -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="Data Management"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <!-- Backup destination -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Backup folder"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{x:Bind ViewModel.BackupDestination, Mode=OneWay}"
                                IsReadOnly="True"
                                PlaceholderText="No backup folder chosen"/>
                        <Button Grid.Column="1"
                               Content="Choose…"
                               Command="{x:Bind ViewModel.PickBackupDestinationCommand}"/>
                        <Button Grid.Column="2"
                               Content="Open Backup Folder"
                               Command="{x:Bind ViewModel.OpenBackupFolderCommand}"/>
                    </Grid>
                    <TextBlock Text="Where scheduled backups and pre-restore safety backups are written (local or network path)"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Schedule + last backup -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Automatic backup"
                              Style="{StaticResource BodyTextBlockStyle}"/>
                    <ComboBox ItemsSource="{x:Bind ViewModel.BackupScheduleOptions}"
                             SelectedItem="{x:Bind ViewModel.SelectedBackupSchedule, Mode=TwoWay}"
                             HorizontalAlignment="Stretch"/>
                    <TextBlock Text="{x:Bind ViewModel.LastBackupDisplay, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Back Up Now / Restore -->
                <StackPanel Spacing="8">
                    <CheckBox Content="Include photos &amp; media"
                             IsChecked="{x:Bind ViewModel.IncludeMediaInBackup, Mode=TwoWay}"/>
                    <CheckBox Content="Include audio recordings"
                             IsChecked="{x:Bind ViewModel.IncludeAudioInBackup, Mode=TwoWay}"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                               HorizontalAlignment="Stretch"
                               Style="{StaticResource AccentButtonStyle}"
                               Command="{x:Bind ViewModel.BackUpNowCommand}"
                               IsEnabled="{x:Bind ViewModel.IsBackingUp, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE898;" FontSize="16"/>
                                <TextBlock Text="Back Up Now"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1"
                               HorizontalAlignment="Stretch"
                               Command="{x:Bind ViewModel.RestoreBackupCommand}"
                               IsEnabled="{x:Bind ViewModel.IsRestoring, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="16"/>
                                <TextBlock Text="Restore…"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar Value="{x:Bind ViewModel.BackupProgress, Mode=OneWay}"
                                Maximum="100"
                                Visibility="{x:Bind ViewModel.IsBackingUp, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsRestoring, Mode=OneWay}"
                                 Width="24" Height="24"
                                 HorizontalAlignment="Left"
                                 Visibility="{x:Bind ViewModel.IsRestoring, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    <TextBlock Text="{x:Bind ViewModel.BackupStatusMessage, Mode=OneWay}"
                              Style="{StaticResource CaptionTextBlockStyle}"
                              TextWrapping="Wrap"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <Border Height="1"
                       Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                       Margin="0,8"/>

                <Button Command="{x:Bind ViewModel.ClearCacheCommand}"
                       HorizontalAlignment="Stretch">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                            <TextBlock Text="Clear Cache"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
                <TextBlock Text="Removes orphaned thumbnails, orphaned media files, and temp leftovers; reports the space actually freed"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Command="{x:Bind ViewModel.ResetSettingsCommand}"
                       HorizontalAlignment="Stretch">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE777;" FontSize="16"/>
                            <TextBlock Text="Reset to Defaults"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>

            <!-- About Section -->
            <StackPanel Spacing="16"
                       Padding="16"
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="1"
                       CornerRadius="8">
                <TextBlock Text="About"
                          Style="{StaticResource SubtitleTextBlockStyle}"/>

                <StackPanel Spacing="4">
                    <TextBlock Text="{x:Bind ViewModel.AppName}"
                              Style="{StaticResource BodyTextBlockStyle}"
                              FontWeight="SemiBold"/>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Version:"/>
                        <Run Text="{x:Bind ViewModel.AppVersion}"/>
                    </TextBlock>
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                        <Run Text="Build Date:"/>
                        <Run Text="{x:Bind ViewModel.BuildDate}"/>
                    </TextBlock>
                </StackPanel>

                <TextBlock Text="A personal memory timeline application powered by AI"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Action Bar -->
            <Grid Padding="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                          Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                          VerticalAlignment="Center"
                          Style="{StaticResource BodyTextBlockStyle}"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                <Button Grid.Column="1"
                       Command="{x:Bind ViewModel.SaveSettingsCommand}"
                       Style="{StaticResource AccentButtonStyle}"
                       MinWidth="120">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ProgressRing IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}"
                                         Width="16" Height="16"
                                         Visibility="{x:Bind ViewModel.IsSaving, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                            <TextBlock Text="Save Settings"/>
                        </StackPanel>
                    </Button.Content>
                </Button>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
