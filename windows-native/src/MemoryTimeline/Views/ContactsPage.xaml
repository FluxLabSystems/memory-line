<Page
    x:Class="MemoryTimeline.Views.ContactsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:MemoryTimeline.Converters"
    xmlns:dtos="using:MemoryTimeline.Core.DTOs"
    xmlns:coreServices="using:MemoryTimeline.Core.Services"
    xmlns:viewmodels="using:MemoryTimeline.ViewModels"
    xmlns:views="using:MemoryTimeline.Views"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="Page_Loaded">

    <Page.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:PersonPhotoConverter x:Key="PersonPhotoConverter"/>
    </Page.Resources>

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="People" Style="{StaticResource TitleTextBlockStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.ContactCountDisplay, Mode=OneWay}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                </Button>
            </Grid>

            <!-- Possible duplicates -->
            <InfoBar Severity="Informational"
                     Title="Possible duplicates found"
                     Message="{x:Bind ViewModel.DuplicateMessage, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasDuplicates, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="DuplicatesInfoBar_CloseButtonClick">
                <InfoBar.ActionButton>
                    <Button Content="Review" Click="ReviewDuplicates_Click"/>
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Error -->
            <InfoBar Severity="Error"
                     Title="Something went wrong"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="ErrorInfoBar_CloseButtonClick"/>

            <!-- Success / info -->
            <InfoBar Severity="Success"
                     Message="{x:Bind ViewModel.InfoMessage, Mode=OneWay}"
                     IsOpen="{x:Bind ViewModel.HasInfo, Mode=OneWay}"
                     IsClosable="True"
                     CloseButtonClick="InfoInfoBar_CloseButtonClick"/>
        </StackPanel>

        <!-- Master-detail -->
        <Grid Grid.Row="1" Margin="0,16,0,0" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======================= Left: contact list ======================= -->
            <Grid Grid.Column="0" RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBox Grid.Row="0"
                         x:Name="SearchBox"
                         PlaceholderText="Search by name, email, company..."
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                <Grid Grid.Row="1" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              x:Name="SortCombo"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="SortCombo_SelectionChanged"
                              ToolTipService.ToolTip="Sort people">
                        <!-- Default matches ContactsViewModel.SortOption (PersonSortOption.Name) -->
                        <ComboBoxItem Content="Sort: Name" Tag="name" IsSelected="True"/>
                        <ComboBoxItem Content="Sort: Recently added" Tag="recent"/>
                        <ComboBoxItem Content="Sort: Most events" Tag="events"/>
                        <ComboBoxItem Content="Sort: Recently updated" Tag="updated"/>
                    </ComboBox>

                    <ToggleButton Grid.Column="1"
                                  IsChecked="{x:Bind ViewModel.FavoritesOnly, Mode=TwoWay}"
                                  ToolTipService.ToolTip="Show favorites only">
                        <FontIcon Glyph="&#xE735;" FontSize="14"/>
                    </ToggleButton>
                </Grid>

                <Button Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="AddPerson_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                        <TextBlock Text="Add Person"/>
                    </StackPanel>
                </Button>

                <Grid Grid.Row="3">
                    <ListView x:Name="ContactsList"
                              ItemsSource="{x:Bind ViewModel.Contacts, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedPerson, Mode=TwoWay}"
                              SelectionMode="Single"
                              DoubleTapped="ContactsList_DoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="dtos:PersonDto">
                                <Grid Padding="4,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Circular initials avatar; the photo (when one is stored) sits on top -->
                                    <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                                        <Ellipse Fill="{x:Bind EffectiveAvatarColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Text="{x:Bind Initials, Mode=OneWay}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="White" FontWeight="SemiBold" FontSize="14"/>
                                        <PersonPicture Width="40" Height="40"
                                                       ProfilePicture="{x:Bind PhotoPath, Mode=OneWay, Converter={StaticResource PersonPhotoConverter}}"
                                                       Visibility="{x:Bind HasPhoto, Mode=OneWay}"/>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <FontIcon Glyph="&#xE735;" FontSize="11"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                                                      VerticalAlignment="Center"
                                                      Visibility="{x:Bind IsFavorite, Mode=OneWay}"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Relationship, Mode=OneWay}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{x:Bind HasRelationship, Mode=OneWay}"/>
                                    </StackPanel>

                                    <!-- Event-count badge -->
                                    <Border Grid.Column="2"
                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                            CornerRadius="10" Padding="8,2"
                                            VerticalAlignment="Center"
                                            Visibility="{x:Bind views:ContactsPage.CountToVisibility(EventCount), Mode=OneWay}">
                                        <TextBlock Text="{x:Bind EventCount, Mode=OneWay}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty state: no contacts at all -->
                    <StackPanel Spacing="12"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ShowNoContacts, Mode=OneWay}">
                        <FontIcon Glyph="&#xE716;" FontSize="40"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No people yet"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Add the people from your life story to link them to your memories."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="260"/>
                        <Button HorizontalAlignment="Center"
                                Style="{StaticResource AccentButtonStyle}"
                                Click="AddPerson_Click">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8FA;" FontSize="14"/>
                                <TextBlock Text="Add your first person"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Empty state: filter matches nothing -->
                    <StackPanel Spacing="8"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.ShowNoMatches, Mode=OneWay}">
                        <FontIcon Glyph="&#xE721;" FontSize="28"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                  HorizontalAlignment="Center"/>
                        <TextBlock Text="No people match"
                                   FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a different search, or turn off the favorites filter."
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                    </StackPanel>

                    <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                  Width="40" Height="40"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- ======================= Right: detail pane ======================= -->
            <Grid Grid.Column="1">

                <!-- Placeholder when nothing is selected -->
                <StackPanel Spacing="10"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{x:Bind ViewModel.ShowNoSelection, Mode=OneWay}">
                    <FontIcon Glyph="&#xE77B;" FontSize="44"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a person"
                               Style="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Pick someone from the list to see their details and the memories you share."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
                </StackPanel>

                <!-- Selected person detail -->
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Stretch">

                        <!-- Identity header -->
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="72" Height="72">
                                <Ellipse Fill="{x:Bind ViewModel.SelectedPerson.EffectiveAvatarColor, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Initials, Mode=OneWay}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="White" FontWeight="SemiBold" FontSize="26"/>
                                <PersonPicture Width="72" Height="72"
                                               ProfilePicture="{x:Bind ViewModel.SelectedPerson.PhotoPath, Mode=OneWay, Converter={StaticResource PersonPhotoConverter}}"
                                               Visibility="{x:Bind ViewModel.SelectedPerson.HasPhoto, Mode=OneWay}"/>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="{x:Bind ViewModel.SelectedPerson.DisplayName, Mode=OneWay}"
                                           Style="{StaticResource TitleTextBlockStyle}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedAddedDisplay, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Command="{x:Bind ViewModel.ToggleSelectedFavoriteCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="{x:Bind ViewModel.SelectedFavoriteGlyph, Mode=OneWay}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedFavoriteLabel, Mode=OneWay}"/>
                                </StackPanel>
                            </Button>
                            <Button Click="EditPerson_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                    <TextBlock Text="Edit"/>
                                </StackPanel>
                            </Button>
                            <Button Click="MergePerson_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE71B;" FontSize="14"/>
                                    <TextBlock Text="Merge"/>
                                </StackPanel>
                            </Button>
                            <Button Click="GeneratePersonStory_Click"
                                    ToolTipService.ToolTip="Generate a readable story of your memories with this person">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                    <TextBlock Text="Generate Story"/>
                                </StackPanel>
                            </Button>
                            <Button Click="DeletePerson_Click">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="Delete"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <!-- Contact details (rows appear only when set) -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Contact details" FontWeight="SemiBold"/>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasRelationship, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE77B;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Relationship" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Relationship, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasEmail, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE715;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Email" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Email, Mode=OneWay}" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasPhone, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE717;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Phone" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Phone, Mode=OneWay}" IsTextSelectionEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasBirthday, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE787;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Birthday" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.BirthdayDisplay, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasCompany, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE821;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Company" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Company, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedHasFirstMet, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE787;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="First met" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedFirstMetDisplay, Mode=OneWay}"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="12" Visibility="{x:Bind ViewModel.SelectedPerson.HasNotes, Mode=OneWay, FallbackValue=Collapsed}">
                                    <FontIcon Glyph="&#xE70B;" FontSize="16"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <StackPanel>
                                        <TextBlock Text="Notes" FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{x:Bind ViewModel.SelectedPerson.Notes, Mode=OneWay}"
                                                   TextWrapping="Wrap" MaxWidth="560"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Text="No contact details yet — use Edit to add some."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           Visibility="{x:Bind ViewModel.SelectedHasNoDetails, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Aliases ("also known as") -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Also known as" FontWeight="SemiBold"/>

                                <TextBlock Text="No aliases yet. Add other names this person goes by so recordings that mention them link here instead of creating a duplicate."
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasNoAliases, Mode=OneWay}"/>

                                <!-- Alias chips -->
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPersonAliases, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="14"
                                                    Padding="10,4">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{x:Bind}" VerticalAlignment="Center"/>
                                                    <Button Click="RemoveAlias_Click"
                                                            Tag="{x:Bind}"
                                                            Padding="2"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            ToolTipService.ToolTip="Remove alias">
                                                        <FontIcon Glyph="&#xE711;" FontSize="10"/>
                                                    </Button>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Add alias -->
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="Add an alias (e.g. a nickname or maiden name)"
                                             Text="{x:Bind ViewModel.NewAliasText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="1"
                                            Command="{x:Bind ViewModel.AddAliasCommand}"
                                            ToolTipService.ToolTip="Add alias">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <FontIcon Glyph="&#xE710;" FontSize="12"/>
                                            <TextBlock Text="Add"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Inline alias error (ci-duplicate, name collision) -->
                                <TextBlock Text="{x:Bind ViewModel.AliasErrorMessage, Mode=OneWay}"
                                           Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                           FontSize="12" TextWrapping="Wrap"
                                           Visibility="{x:Bind ViewModel.HasAliasError, Mode=OneWay}"/>
                            </StackPanel>
                        </Border>

                        <!-- Statistics (first/last appearance + shared-memory count);
                             the profile's co-occurrence/location aggregates have
                             their own Connections card below. -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedPerson.EventCountDisplay, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Shared memories" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedFirstEventDisplay, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="First event" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Spacing="2">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedLastEventDisplay, Mode=OneWay}"
                                               FontWeight="SemiBold" FontSize="16"/>
                                    <TextBlock Text="Latest event" FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Connections: the people this person shares the most
                             memories with and the places those memories happened
                             (IPersonService.GetProfileAsync aggregates, five each).
                             Hidden entirely when there is nothing to show. -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="8" Padding="16"
                                Visibility="{x:Bind ViewModel.HasConnections, Mode=OneWay}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Connections" Style="{StaticResource SubtitleTextBlockStyle}"/>

                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.HasCoOccurring, Mode=OneWay}">
                                    <TextBlock Text="Often together with" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ListView ItemsSource="{x:Bind ViewModel.SelectedPersonCoOccurring, Mode=OneWay}"
                                              SelectionMode="None"
                                              IsItemClickEnabled="True"
                                              ItemClick="CoOccurring_ItemClick">
                                        <ListView.ItemTemplate>
                                            <DataTemplate x:DataType="coreServices:PersonCoOccurrence">
                                                <Grid ColumnSpacing="12" Padding="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE77B;" FontSize="14"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind SharedEventsDisplay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                </StackPanel>

                                <StackPanel Spacing="4"
                                            Visibility="{x:Bind ViewModel.HasTopLocations, Mode=OneWay}">
                                    <TextBlock Text="Places" FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedPersonTopLocations, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="coreServices:PersonLocationCount">
                                                <Grid ColumnSpacing="12" Padding="4,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <FontIcon Grid.Column="0" Glyph="&#xE707;" FontSize="14"
                                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                              VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{x:Bind Name}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{x:Bind CountDisplay}"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Linked events -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Events" Style="{StaticResource SubtitleTextBlockStyle}"/>

                            <TextBlock Text="No events are linked to this person yet."
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="{x:Bind ViewModel.HasNoLinkedEvents, Mode=OneWay}"/>

                            <ListView ItemsSource="{x:Bind ViewModel.SelectedPersonEvents, Mode=OneWay}"
                                      SelectionMode="None"
                                      IsItemClickEnabled="True"
                                      ItemClick="LinkedEvents_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="coreServices:PersonEventSummary">
                                        <Grid Padding="12" Margin="0,4"
                                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                              CornerRadius="8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{x:Bind Title}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <Border Grid.Column="1"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="4" Padding="8,2"
                                                    VerticalAlignment="Center"
                                                    Visibility="{x:Bind Category, Converter={StaticResource NullToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind Category}" FontSize="11" Foreground="White"/>
                                            </Border>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                                        VerticalAlignment="Center">
                                                <FontIcon Glyph="&#xE787;" FontSize="12"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="{x:Bind StartDateDisplay}" FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ======================= Person editor dialog ======================= -->
        <ContentDialog x:Name="PersonDialog"
                       Title="Add Person"
                       PrimaryButtonText="Save"
                       SecondaryButtonText="Save as Draft"
                       CloseButtonText="Cancel"
                       DefaultButton="Primary"
                       PrimaryButtonClick="PersonDialog_PrimaryButtonClick"
                       SecondaryButtonClick="PersonDialog_SecondaryButtonClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <StackPanel Spacing="12" MinWidth="420" Margin="0,0,12,0">
                    <TextBox x:Name="EditorNameBox"
                             Header="Name (required)"
                             PlaceholderText="Full name"/>
                    <TextBlock x:Name="EditorValidationText"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed"/>

                    <TextBox x:Name="EditorNicknameBox"
                             Header="Nickname"
                             PlaceholderText="What you call them"/>

                    <ComboBox x:Name="EditorRelationshipCombo"
                              Header="Relationship"
                              IsEditable="True"
                              HorizontalAlignment="Stretch"
                              PlaceholderText="e.g. Friend — or type your own">
                        <x:String>Family</x:String>
                        <x:String>Friend</x:String>
                        <x:String>Partner</x:String>
                        <x:String>Colleague</x:String>
                        <x:String>Classmate</x:String>
                        <x:String>Neighbor</x:String>
                        <x:String>Acquaintance</x:String>
                    </ComboBox>

                    <TextBox x:Name="EditorEmailBox"
                             Header="Email"
                             PlaceholderText="name@example.com"/>

                    <TextBox x:Name="EditorPhoneBox"
                             Header="Phone"
                             PlaceholderText="Phone number"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker Grid.Column="0"
                                            x:Name="EditorBirthdayPicker"
                                            Header="Birthday"
                                            PlaceholderText="Pick a date"
                                            HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="ClearBirthday_Click"
                                ToolTipService.ToolTip="Clear birthday">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <TextBox x:Name="EditorCompanyBox"
                             Header="Company"
                             PlaceholderText="Company or organization"/>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CalendarDatePicker Grid.Column="0"
                                            x:Name="EditorFirstMetPicker"
                                            Header="First met"
                                            PlaceholderText="Pick a date"
                                            HorizontalAlignment="Stretch"/>
                        <Button Grid.Column="1"
                                VerticalAlignment="Bottom"
                                Click="ClearFirstMet_Click"
                                ToolTipService.ToolTip="Clear first-met date">
                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                        </Button>
                    </Grid>

                    <TextBox x:Name="EditorNotesBox"
                             Header="Notes"
                             PlaceholderText="Anything worth remembering about them"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             Height="80"/>

                    <!-- Photo: chosen with a file picker, copied into the managed
                         media tree on Save (people/ folder, kept by Clear Cache
                         while a person references it). -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Photo" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <PersonPicture x:Name="EditorPhotoPreview" Width="56" Height="56"/>
                            <Button Content="Choose photo…"
                                    Click="ChoosePhoto_Click"
                                    VerticalAlignment="Center"/>
                            <Button x:Name="RemovePhotoButton"
                                    Content="Remove"
                                    Click="RemovePhoto_Click"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Avatar color" FontWeight="SemiBold"/>
                        <GridView x:Name="EditorColorGrid"
                                  SelectionMode="Single"
                                  SelectionChanged="EditorColorGrid_SelectionChanged"
                                  ItemsSource="{x:Bind ViewModel.AvatarColorOptions}">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:AvatarColorOption">
                                    <Grid Width="36" Height="36" Margin="2"
                                          ToolTipService.ToolTip="{x:Bind ToolTipText}">
                                        <Ellipse Width="32" Height="32"
                                                 Fill="{x:Bind SwatchHex, Converter={StaticResource HexToBrushConverter}}"/>
                                        <TextBlock Text="Auto"
                                                   FontSize="9" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{x:Bind IsAuto}"/>
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                            <GridView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="11"/>
                                </ItemsPanelTemplate>
                            </GridView.ItemsPanel>
                        </GridView>
                    </StackPanel>

                    <CheckBox x:Name="EditorFavoriteCheckBox"
                              Content="Mark as favorite"/>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- ======================= Merge dialog ======================= -->
        <ContentDialog x:Name="MergeDialog"
                       Title="Merge People"
                       PrimaryButtonText="Merge"
                       CloseButtonText="Cancel"
                       DefaultButton="Close"
                       PrimaryButtonClick="MergeDialog_PrimaryButtonClick">
            <StackPanel Spacing="12" MinWidth="400">
                <TextBlock x:Name="MergeSourceText" TextWrapping="Wrap"/>

                <ComboBox x:Name="MergeTargetCombo"
                          Header="Merge into"
                          DisplayMemberPath="DisplayName"
                          ItemsSource="{x:Bind ViewModel.MergeCandidates, Mode=OneWay}"
                          HorizontalAlignment="Stretch"
                          PlaceholderText="Choose a person"/>

                <InfoBar x:Name="MergeWarningBar"
                         Severity="Warning"
                         Title="This cannot be undone"
                         IsOpen="True"
                         IsClosable="False"/>
            </StackPanel>
        </ContentDialog>

        <!-- ======================= Delete confirmation ======================= -->
        <ContentDialog x:Name="DeletePersonDialog"
                       Title="Delete Person"
                       PrimaryButtonText="Delete"
                       CloseButtonText="Cancel"
                       DefaultButton="Close"
                       PrimaryButtonClick="DeletePersonDialog_PrimaryButtonClick">
            <TextBlock x:Name="DeletePersonText" TextWrapping="Wrap" MaxWidth="400"/>
        </ContentDialog>
    </Grid>
</Page>
