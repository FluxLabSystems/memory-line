<Window
    x:Class="MemoryTimeline.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Memory Timeline">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.KeyboardAccelerators>
            <!-- Ctrl+R refreshes the current page in place (timeline refresh, not renavigation) -->
            <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="Refresh_Invoked"/>
            <!-- Ctrl+Shift+V opens the paste-text capture dialog on the Queue page -->
            <KeyboardAccelerator Key="V" Modifiers="Control,Shift" Invoked="PasteCapture_Invoked"/>
        </Grid.KeyboardAccelerators>
        <!-- IsBackEnabled and the selected item are kept in sync with the Frame by
             MainWindow.OnNavigationServiceNavigated, so programmatic navigations
             (view on timeline, draft resume, Jump List / toast activation) and
             back/forward highlight the page actually shown. -->
        <NavigationView
            x:Name="NavigationView"
            IsBackButtonVisible="Auto"
            IsBackEnabled="False"
            IsSettingsVisible="True"
            PaneDisplayMode="Top"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            SelectionChanged="NavigationView_SelectionChanged"
            BackRequested="NavigationView_BackRequested">

            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Timeline" Tag="Timeline" Icon="Calendar"/>
                <NavigationViewItem Content="Ask" Tag="Ask">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9CE;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <!-- Badge counts come from MainViewModel (pending + failed queue
                     items; events awaiting review) and hide at zero. -->
                <NavigationViewItem Content="Queue" Tag="Queue" Icon="Microphone">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.QueueBadgeCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsQueueBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Review" Tag="Review" Icon="Accept">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge Value="{x:Bind ViewModel.ReviewBadgeCount, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.IsReviewBadgeVisible, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="People" Tag="People">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE716;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connections" Tag="Connections">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71B;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Eras" Tag="Eras">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Map" Tag="Map">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE707;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Search" Tag="Search" Icon="Find"/>
                <NavigationViewItem Content="Analytics" Tag="Analytics">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D2;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <!-- Pages will be navigated here -->
            </Frame>
        </NavigationView>
    </Grid>
</Window>
