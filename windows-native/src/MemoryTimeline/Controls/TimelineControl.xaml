<UserControl
    x:Class="MemoryTimeline.Controls.TimelineControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:MemoryTimeline.Controls"
    xmlns:dto="using:MemoryTimeline.Core.DTOs"
    xmlns:vm="using:MemoryTimeline.ViewModels"
    mc:Ignorable="d"
    d:DesignHeight="600"
    d:DesignWidth="1000">

    <Grid x:Name="RootGrid" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Era filter panel (collapsible) -->
            <RowDefinition Height="Auto"/>
            <!-- Main timeline area with era bars and events -->
            <RowDefinition Height="*"/>
            <!-- Proportional scrollbar -->
            <RowDefinition Height="Auto"/>
            <!-- Bottom command bar -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <Grid x:Name="LoadingOverlay"
              Grid.RowSpan="4"
              Visibility="Collapsed"
              Background="#80000000"
              Canvas.ZIndex="1000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing IsActive="True" Width="48" Height="48"/>
                <TextBlock Text="Loading timeline..."
                          FontSize="16"
                          Foreground="White"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Era filter panel -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Era Filters:"
                          VerticalAlignment="Center"
                          FontWeight="SemiBold"
                          Margin="0,0,12,0"/>

                <!-- Era filter checkboxes (populated dynamically) -->
                <ItemsControl x:Name="EraFiltersPanel"
                             Grid.Column="1"
                             ItemsSource="{x:Bind ViewModel.EraFilters, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="16"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:EraFilterDto">
                            <CheckBox Content="{x:Bind Name}"
                                     IsChecked="{x:Bind IsVisible, Mode=TwoWay}"
                                     Foreground="{x:Bind ColorCode, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                    <Button Content="All"
                           Click="ShowAllEras_Click"
                           Padding="8,4"/>
                    <Button Content="None"
                           Click="HideAllEras_Click"
                           Padding="8,4"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main timeline area - NO ScrollViewer, just a clipped container -->
        <Grid x:Name="TimelineContainer"
              Grid.Row="1"
              Background="Transparent">

            <!-- Timeline canvas fills the container, content positioned relative to viewport -->
            <Grid x:Name="TimelineCanvas"
                  Background="Transparent"
                  ManipulationMode="TranslateX,TranslateInertia"
                  ManipulationDelta="TimelineCanvas_ManipulationDelta"
                  ManipulationCompleted="TimelineCanvas_ManipulationCompleted"
                  DoubleTapped="TimelineCanvas_DoubleTapped"
                  RightTapped="TimelineCanvas_RightTapped"
                  PointerMoved="TimelineCanvas_PointerMoved">

                <Grid.RowDefinitions>
                    <!-- Events area (map pins stack upward from era bars) -->
                    <RowDefinition Height="*" MinHeight="200"/>
                    <!-- Era bars area (thin horizontal colored lines) -->
                    <RowDefinition Height="Auto"/>
                    <!-- Timeline axis and ticks (bottom quarter) -->
                    <RowDefinition Height="80"/>
                </Grid.RowDefinitions>

                <!-- Context menu for timeline canvas (add event) -->
                <Grid.ContextFlyout>
                    <MenuFlyout x:Name="TimelineContextMenu">
                        <MenuFlyoutItem x:Name="AddEventMenuItem"
                                       Text="Add Event Here"
                                       Click="AddEventMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE710;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator/>
                        <MenuFlyoutItem Text="Go to Date..."
                                       Click="GoToDateMenuItem_Click">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8DA;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Go to Today"
                                       Command="{x:Bind ViewModel.GoToTodayCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE8D1;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Refresh"
                                       Command="{x:Bind ViewModel.RefreshCommand}">
                            <MenuFlyoutItem.Icon>
                                <FontIcon Glyph="&#xE72C;"/>
                            </MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>

                <!-- Events layer - three stacked sub-layers positioned in the
                     same coordinate space: uncertainty underlays (bottom),
                     duration span bars (middle), map pins (top). Transforms
                     and visibility are OneWay so pan/zoom shifts reposition
                     already-rendered items in place without container churn. -->
                <Canvas x:Name="EventsCanvas" Grid.Row="0" Grid.RowSpan="2">
                    <!-- Uncertainty underlays: soft gradient bands spanning the
                         DatePrecision window of approximate events (F1). -->
                    <ItemsControl x:Name="UncertaintyLayer"
                                 ItemsSource="{x:Bind ViewModel.UncertainEvents, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:TimelineEventDto">
                                <Rectangle Width="{x:Bind WindowWidth, Mode=OneWay}"
                                          Height="{x:Bind Height, Mode=OneWay}"
                                          Fill="{x:Bind CategoryColor, Converter={StaticResource HexToUncertaintyBrushConverter}}"
                                          RadiusX="4"
                                          RadiusY="4"
                                          IsHitTestVisible="False"
                                          Visibility="{x:Bind ShowUncertaintyBand, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform X="{x:Bind WindowStartX, Mode=OneWay}" Y="{x:Bind PixelY, Mode=OneWay}"/>
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Span bars: duration events wide enough to earn a real
                         width (left edge anchored on the start date). The
                         element geometry binds the CLAMPED RenderX/RenderWidth
                         (viewport + margin) rather than the true PixelX/Width,
                         so a decades-long span at Day zoom never materializes
                         a multi-million-pixel element; the overhang chevrons
                         mark the clipped ends. -->
                    <ItemsControl x:Name="SpansLayer"
                                 ItemsSource="{x:Bind ViewModel.SpanEvents, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:TimelineEventDto">
                                <controls:EventSpanBar Event="{x:Bind Mode=OneWay}"
                                                      Width="{x:Bind RenderWidth, Mode=OneWay}"
                                                      Height="24"
                                                      Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Tapped="EventBubble_Tapped"
                                                      RightTapped="EventBubble_RightTapped"
                                                      PointerEntered="EventBubble_PointerEntered"
                                                      PointerExited="EventBubble_PointerExited">
                                    <controls:EventSpanBar.RenderTransform>
                                        <TranslateTransform X="{x:Bind RenderX, Mode=OneWay}" Y="{x:Bind PixelY, Mode=OneWay}"/>
                                    </controls:EventSpanBar.RenderTransform>
                                    <controls:EventSpanBar.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="View Details"
                                                           Click="ViewEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A7;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Edit Event"
                                                           Click="EditEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="History&#x2026;"
                                                           Click="EventHistoryMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81C;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="Delete Event"
                                                           Click="DeleteEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </controls:EventSpanBar.ContextFlyout>
                                </controls:EventSpanBar>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Map pins (point-in-time and short-duration events) -->
                    <ItemsControl x:Name="EventsLayer"
                                 ItemsSource="{x:Bind ViewModel.Events, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:TimelineEventDto">
                                <controls:EventBubble Event="{x:Bind Mode=OneWay}"
                                                     Width="{x:Bind Width}"
                                                     Height="{x:Bind Height}"
                                                     Visibility="{x:Bind IsVisible, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                     Tapped="EventBubble_Tapped"
                                                     RightTapped="EventBubble_RightTapped"
                                                     PointerEntered="EventBubble_PointerEntered"
                                                     PointerExited="EventBubble_PointerExited">
                                    <controls:EventBubble.RenderTransform>
                                        <TranslateTransform X="{x:Bind PixelX, Mode=OneWay}" Y="{x:Bind PixelY, Mode=OneWay}"/>
                                    </controls:EventBubble.RenderTransform>
                                    <controls:EventBubble.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="View Details"
                                                           Click="ViewEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A7;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Edit Event"
                                                           Click="EditEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE70F;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="History&#x2026;"
                                                           Click="EventHistoryMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE81C;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator/>
                                            <MenuFlyoutItem Text="Delete Event"
                                                           Click="DeleteEventMenuItem_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;"/>
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </controls:EventBubble.ContextFlyout>
                                </controls:EventBubble>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Canvas>

                <!-- Era bars layer - thin horizontal colored lines showing time spans -->
                <ItemsControl x:Name="EraBarsLayer"
                             Grid.Row="1"
                             ItemsSource="{x:Bind ViewModel.VisibleEraBars, Mode=OneWay}"
                             Height="{x:Bind ViewModel.EraBarsHeight, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dto:EraBarDto">
                            <Rectangle Fill="{x:Bind ColorCode, Mode=OneWay, Converter={StaticResource HexToBrushConverter}}"
                                      Width="{x:Bind Width}"
                                      Height="4"
                                      RadiusX="2"
                                      RadiusY="2"
                                      Opacity="0.9">
                                <Rectangle.RenderTransform>
                                    <TranslateTransform X="{x:Bind PixelX}" Y="{x:Bind TrackY}"/>
                                </Rectangle.RenderTransform>
                            </Rectangle>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Timeline axis and ticks (bottom area) -->
                <Grid Grid.Row="2">
                    <!-- Timeline axis line -->
                    <Canvas x:Name="AxisCanvas">
                        <Line x:Name="TimelineAxis"
                              X1="0" Y1="0"
                              X2="10000" Y2="0"
                              Stroke="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                              StrokeThickness="2"/>
                    </Canvas>

                    <!-- Time ruler ticks layer - Adobe Premiere style adaptive density -->
                    <ItemsControl x:Name="TimeRulerLayer"
                                 ItemsSource="{x:Bind ViewModel.TimeRulerTicks, Mode=OneWay}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="dto:TimeRulerTickDto">
                                <StackPanel Orientation="Vertical">
                                    <!-- Tick mark -->
                                    <Rectangle Width="1"
                                              Height="{x:Bind TickHeight}"
                                              Fill="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                    <!-- Label (only visible for major ticks) -->
                                    <TextBlock Text="{x:Bind Label}"
                                              FontSize="10"
                                              Opacity="{x:Bind LabelOpacity}"
                                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                              Margin="-20,2,0,0"/>
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform X="{x:Bind PixelX}" Y="0"/>
                                    </StackPanel.RenderTransform>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Swimlane gutter (lane modes only): fixed labels overlaying
                     the left edge of the events area, one row per lane. Row
                     heights come from the same lane constants the events use,
                     so gutter rows stay aligned with lane rows.
                     DEFERRED (F8 wave; still open 2026-10): vertical lane
                     scrolling. The events area does not scroll vertically,
                     and neither does this, so lanes past the viewport bottom
                     are reachable only by collapsing the lanes above them.
                     The spec's synchronised vertical-scroll note needs a
                     shared scroll surface over the events canvas plus this
                     gutter and is intentionally out of scope here (see the
                     reorderable-lanes precedent in LaneAssignment.cs). -->
                <Border x:Name="LaneGutter"
                       Grid.Row="0"
                       Width="140"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Stretch"
                       Background="{ThemeResource LayerFillColorDefaultBrush}"
                       BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                       BorderThickness="0,0,1,0"
                       Visibility="{x:Bind ViewModel.IsLaneModeActive, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.LaneGutterRows, Mode=OneWay}"
                                 VerticalAlignment="Top">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:LaneGutterRowDto">
                                <Grid Height="{x:Bind RowHeight}">
                                    <!-- Alternating row stripe -->
                                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                           Opacity="{x:Bind StripeOpacity}"/>
                                    <StackPanel Orientation="Horizontal"
                                               Spacing="4"
                                               Padding="4,0"
                                               VerticalAlignment="Center">
                                        <Button Background="Transparent"
                                               BorderThickness="0"
                                               Padding="2"
                                               VerticalAlignment="Center"
                                               Click="LaneCollapse_Click"
                                               AutomationProperties.Name="{x:Bind AutomationLabel}"
                                               ToolTipService.ToolTip="Collapse or expand this lane">
                                            <FontIcon Glyph="{x:Bind ChevronGlyph}" FontSize="10"/>
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind Label}"
                                                      FontSize="12"
                                                      FontWeight="SemiBold"
                                                      TextTrimming="CharacterEllipsis"
                                                      MaxWidth="96"/>
                                            <TextBlock Text="{x:Bind CountDisplay}"
                                                      FontSize="10"
                                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                                      Visibility="{x:Bind IsCollapsed, Converter={StaticResource InvertedBoolToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </Grid>

            <!-- Zoom controls overlay -->
            <StackPanel Orientation="Horizontal"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,12,20,0"
                       Spacing="8"
                       Canvas.ZIndex="100">

                <!-- Quick date navigation -->
                <TextBox x:Name="QuickDateBox"
                        PlaceholderText="mmddyy or yyyy"
                        AutomationProperties.Name="Quick date navigation"
                        Width="110"
                        VerticalAlignment="Center"
                        KeyDown="QuickDateBox_KeyDown"/>

                <Button Content="&#xE71E;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       AutomationProperties.Name="Zoom out"
                       ToolTipService.ToolTip="Zoom out"
                       Command="{x:Bind ViewModel.ZoomOutCommand}"
                       IsEnabled="{x:Bind ViewModel.CanZoomOut, Mode=OneWay}"
                       Style="{StaticResource AccentButtonStyle}"
                       Width="40" Height="40"/>

                <ComboBox x:Name="ZoomLevelCombo"
                         SelectedIndex="1"
                         Width="120"
                         SelectionChanged="ZoomLevelCombo_SelectionChanged">
                    <ComboBoxItem Content="Year View" Tag="Year"/>
                    <ComboBoxItem Content="Month View" Tag="Month"/>
                    <ComboBoxItem Content="Week View" Tag="Week"/>
                    <ComboBoxItem Content="Day View" Tag="Day"/>
                </ComboBox>

                <Button Content="&#xE71D;"
                       FontFamily="Segoe MDL2 Assets"
                       FontSize="16"
                       AutomationProperties.Name="Zoom in"
                       ToolTipService.ToolTip="Zoom in"
                       Command="{x:Bind ViewModel.ZoomInCommand}"
                       IsEnabled="{x:Bind ViewModel.CanZoomIn, Mode=OneWay}"
                       Style="{StaticResource AccentButtonStyle}"
                       Width="40" Height="40"/>
            </StackPanel>

            <!-- Event details panel (slides in from right) -->
            <Grid x:Name="EventDetailsPanel"
                  HorizontalAlignment="Right"
                  Width="320"
                  Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                  Visibility="{x:Bind ViewModel.SelectedEvent, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}"
                  Canvas.ZIndex="200">

                <ScrollViewer>
                    <StackPanel Padding="20" Spacing="12">
                        <Grid>
                            <TextBlock Text="Event Details"
                                      FontSize="20"
                                      FontWeight="SemiBold"/>
                            <Button Content="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   HorizontalAlignment="Right"
                                   Background="Transparent"
                                   AutomationProperties.Name="Close event details"
                                   ToolTipService.ToolTip="Close"
                                   Command="{x:Bind ViewModel.SelectEventCommand}"/>
                        </Grid>

                        <TextBlock Text="{x:Bind ViewModel.SelectedEvent.Title, Mode=OneWay, FallbackValue=''}"
                                  FontSize="16"
                                  FontWeight="SemiBold"
                                  TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE787;" FontSize="14"/>
                            <!-- Precision-honest date ("Summer 1998"), not a raw DateTime -->
                            <TextBlock Text="{x:Bind ViewModel.SelectedEvent.DisplayDate, Mode=OneWay, FallbackValue=''}"
                                      FontSize="14"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <!-- People linked to the event (loaded lazily on selection) -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                   Visibility="{x:Bind ViewModel.SelectedEvent.HasPeople, Mode=OneWay, FallbackValue=Collapsed, Converter={StaticResource BoolToVisibilityConverter}}">
                            <FontIcon Glyph="&#xE716;" FontSize="14" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedEvent.PeopleDisplay, Mode=OneWay, FallbackValue=''}"
                                      FontSize="14"
                                      TextWrapping="Wrap"
                                      MaxWidth="250"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <TextBlock Text="{x:Bind ViewModel.SelectedEvent.Description, Mode=OneWay, FallbackValue=''}"
                                  TextWrapping="Wrap"
                                  FontSize="14"/>

                        <!-- Media strip: horizontal thumbnails + add/drop targets.
                             Click opens the lightbox; drops attach files. -->
                        <StackPanel Spacing="8"
                                   Background="Transparent"
                                   AllowDrop="True"
                                   DragOver="MediaDropTarget_DragOver"
                                   Drop="DetailsMediaStrip_Drop">
                            <Grid>
                                <TextBlock Text="{x:Bind ViewModel.SelectedEventMediaHeader, Mode=OneWay}"
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>
                                <Button Content="Add photos..."
                                       FontSize="12"
                                       Padding="8,4"
                                       HorizontalAlignment="Right"
                                       Click="AddPhotosToSelectedEvent_Click"
                                       ToolTipService.ToolTip="Attach photos to this event"/>
                            </Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                         VerticalScrollBarVisibility="Disabled"
                                         HorizontalScrollMode="Enabled">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.SelectedEventMedia, Mode=OneWay}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EventMediaThumbDto">
                                            <Button Padding="0"
                                                   BorderThickness="0"
                                                   Background="Transparent"
                                                   Click="MediaThumb_Click"
                                                   ToolTipService.ToolTip="{x:Bind Caption, Mode=OneWay}"
                                                   AutomationProperties.Name="{x:Bind FileName}">
                                                <Grid Width="72" Height="72"
                                                     CornerRadius="4"
                                                     Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                    <Image Source="{x:Bind ThumbnailImage}"
                                                          Stretch="UniformToFill"/>
                                                    <FontIcon Glyph="{x:Bind FileGlyph}"
                                                             FontSize="24"
                                                             Visibility="{x:Bind HasImage, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                                                             HorizontalAlignment="Center"
                                                             VerticalAlignment="Center"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="Drop image files here to attach them"
                                      FontSize="11"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                            <Button Content="Edit"
                                   Click="EditSelectedEvent_Click"
                                   Style="{StaticResource AccentButtonStyle}"
                                   Width="80">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="E" Modifiers="Control"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                            <Button Content="Delete"
                                   Click="DeleteSelectedEvent_Click"
                                   Width="80">
                                <Button.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="Delete"/>
                                </Button.KeyboardAccelerators>
                            </Button>
                        </StackPanel>

                        <Button Content="View connections"
                               Click="ViewConnections_Click"
                               HorizontalAlignment="Stretch"
                               ToolTipService.ToolTip="Explore events related to this one"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- Visible error surface for timeline operations (load/refresh/create).
             Replaces the old silent StatusText-only error channel. -->
        <InfoBar x:Name="TimelineErrorBar"
                Grid.Row="1"
                Severity="Error"
                Title="Timeline error"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                IsOpen="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource NullToFalseConverter}}"
                IsClosable="True"
                Closed="TimelineErrorBar_Closed"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Stretch"
                Margin="12,0,12,8"
                Canvas.ZIndex="300"/>

        <!-- Proportional scrollbar (Premiere-style) -->
        <controls:ProportionalScrollBar x:Name="TimelineScrollBar"
                                        Grid.Row="2"
                                        Height="20"
                                        Margin="8,4"
                                        ScrollOffsetChanged="TimelineScrollBar_ScrollOffsetChanged"
                                        ViewDurationChanged="TimelineScrollBar_ViewDurationChanged"/>

        <!-- Navigation controls -->
        <CommandBar Grid.Row="3"
                   DefaultLabelPosition="Right"
                   Canvas.ZIndex="100">

            <AppBarButton Label="Add Event"
                         Click="AddEventButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE710;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarSeparator/>

            <AppBarButton Label="Go to Today"
                         Command="{x:Bind ViewModel.GoToTodayCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8D1;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton Label="Refresh"
                         Command="{x:Bind ViewModel.RefreshCommand}">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton Label="Generate Story"
                         Click="GenerateStoryButton_Click"
                         ToolTipService.ToolTip="Generate a readable story of the visible date range">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A5;"/>
                </AppBarButton.Icon>
            </AppBarButton>

            <AppBarButton x:Name="LaneModeButton"
                         Label="Lanes"
                         ToolTipService.ToolTip="Group events into horizontal swimlanes">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8FD;"/>
                </AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <RadioMenuFlyoutItem x:Name="LaneModeAutoItem"
                                            Text="Auto (stacked)"
                                            Tag="Auto"
                                            GroupName="LaneModeGroup"
                                            IsChecked="True"
                                            Click="LaneModeItem_Click"/>
                        <RadioMenuFlyoutItem x:Name="LaneModeCategoryItem"
                                            Text="By category"
                                            Tag="Category"
                                            GroupName="LaneModeGroup"
                                            Click="LaneModeItem_Click"/>
                        <RadioMenuFlyoutItem x:Name="LaneModePersonItem"
                                            Text="By person"
                                            Tag="Person"
                                            GroupName="LaneModeGroup"
                                            Click="LaneModeItem_Click"/>
                        <RadioMenuFlyoutItem x:Name="LaneModeLocationItem"
                                            Text="By location"
                                            Tag="Location"
                                            GroupName="LaneModeGroup"
                                            Click="LaneModeItem_Click"/>
                        <RadioMenuFlyoutItem x:Name="LaneModeEraItem"
                                            Text="By era"
                                            Tag="Era"
                                            GroupName="LaneModeGroup"
                                            Click="LaneModeItem_Click"/>
                        <RadioMenuFlyoutItem x:Name="LaneModeTagItem"
                                            Text="By tag"
                                            Tag="Tag"
                                            GroupName="LaneModeGroup"
                                            Click="LaneModeItem_Click"/>
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>

            <AppBarSeparator/>

            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0">
                    <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                              VerticalAlignment="Center"
                              FontSize="14"/>
                    <TextBlock x:Name="HoverDateText"
                              VerticalAlignment="Center"
                              FontSize="12"
                              Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                              Visibility="Collapsed"/>
                </StackPanel>
            </CommandBar.Content>
        </CommandBar>

        <!-- Add/Edit Event Dialog (enriched: dates, category, era, location,
             description, people picker with chips, tags editor, draft save) -->
        <ContentDialog x:Name="EventDialog"
                      Title="Add Event"
                      PrimaryButtonText="Save"
                      SecondaryButtonText="Save as Draft"
                      CloseButtonText="Cancel"
                      DefaultButton="Primary"
                      PrimaryButtonClick="EventDialog_PrimaryButtonClick"
                      SecondaryButtonClick="EventDialog_SecondaryButtonClick">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         MaxHeight="560">
                <StackPanel Spacing="14" MinWidth="440" Margin="0,0,12,0">
                    <!-- In-dialog error surface: keeps the dialog open and shows a
                         validation summary or the reason a save failed. -->
                    <InfoBar x:Name="EventDialogErrorBar"
                            Severity="Error"
                            IsOpen="False"
                            IsClosable="True"
                            Title="Could not save event"/>

                    <TextBox x:Name="EventTitleBox"
                            Header="Title"
                            PlaceholderText="Enter event title"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Start date" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="EventDateTextBox"
                                    PlaceholderText="mmddyy"
                                    Width="100"
                                    TextChanged="EventDateTextBox_TextChanged"/>
                            <TextBlock Text="or" VerticalAlignment="Center"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                            <CalendarDatePicker x:Name="EventDatePicker"
                                               PlaceholderText="Select date"
                                               DateFormat="{}{month.full} {day.integer}, {year.full}"
                                               DateChanged="EventDatePicker_DateChanged"/>
                        </StackPanel>
                        <!-- Date precision: how much of the start date to believe.
                             Coarser than Day shows a live human-form preview. -->
                        <TextBlock Text="Date precision" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="EventPrecisionCombo"
                                     Width="150"
                                     AutomationProperties.Name="Date precision"
                                     SelectionChanged="EventPrecisionCombo_SelectionChanged">
                                <ComboBoxItem Content="Exact time" Tag="exact"/>
                                <ComboBoxItem Content="Day" Tag="day"/>
                                <ComboBoxItem Content="Month" Tag="month"/>
                                <ComboBoxItem Content="Season" Tag="season"/>
                                <ComboBoxItem Content="Year" Tag="year"/>
                                <ComboBoxItem Content="Decade" Tag="decade"/>
                                <ComboBoxItem Content="Unknown" Tag="unknown"/>
                            </ComboBox>
                            <TextBlock x:Name="EventPrecisionPreview"
                                      VerticalAlignment="Center"
                                      FontStyle="Italic"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                                      Visibility="Collapsed"/>
                        </StackPanel>
                        <TextBlock Text="End date (optional)" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <CalendarDatePicker x:Name="EventEndDatePicker"
                                               PlaceholderText="Select end date"
                                               DateFormat="{}{month.full} {day.integer}, {year.full}"/>
                            <Button Content="&#xE711;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   AutomationProperties.Name="Clear end date"
                                   ToolTipService.ToolTip="Clear end date"
                                   Click="ClearEndDateButton_Click"/>
                        </StackPanel>
                    </StackPanel>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="EventCategoryCombo"
                                 Grid.Column="0"
                                 Header="Category"
                                 PlaceholderText="Select category"
                                 HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="Milestone" Tag="milestone"/>
                            <ComboBoxItem Content="Work" Tag="work"/>
                            <ComboBoxItem Content="Education" Tag="education"/>
                            <ComboBoxItem Content="Relationship" Tag="relationship"/>
                            <ComboBoxItem Content="Travel" Tag="travel"/>
                            <ComboBoxItem Content="Achievement" Tag="achievement"/>
                            <ComboBoxItem Content="Challenge" Tag="challenge"/>
                            <ComboBoxItem Content="Era" Tag="era"/>
                            <ComboBoxItem Content="Other" Tag="other"/>
                        </ComboBox>

                        <ComboBox x:Name="EventEraCombo"
                                 Grid.Column="1"
                                 Header="Era"
                                 PlaceholderText="None"
                                 HorizontalAlignment="Stretch"
                                 ItemsSource="{x:Bind ViewModel.DialogEraChoices, Mode=OneWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:EventEraChoiceDto">
                                    <TextBlock Text="{x:Bind Name}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <TextBox x:Name="EventLocationBox"
                            Header="Location (optional)"
                            PlaceholderText="Enter location"/>

                    <TextBox x:Name="EventDescriptionBox"
                            Header="Description"
                            PlaceholderText="Enter description (optional)"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            Height="90"/>

                    <!-- People picker: suggestions from contacts; free text adds a
                         pending "new" person chip that is created on save. -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="People" FontWeight="SemiBold"/>
                        <AutoSuggestBox x:Name="PersonSuggestBox"
                                       PlaceholderText="Add a person by name"
                                       QueryIcon="AddFriend"
                                       TextChanged="PersonSuggestBox_TextChanged"
                                       SuggestionChosen="PersonSuggestBox_SuggestionChosen"
                                       QuerySubmitted="PersonSuggestBox_QuerySubmitted">
                            <AutoSuggestBox.ItemTemplate>
                                <DataTemplate x:DataType="dto:PersonDto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{x:Bind DisplayName}"/>
                                        <TextBlock Text="{x:Bind EventCountDisplay}"
                                                  FontSize="12"
                                                  VerticalAlignment="Center"
                                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </AutoSuggestBox.ItemTemplate>
                        </AutoSuggestBox>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollMode="Enabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DialogPeople, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventPersonChipDto">
                                        <Button Click="PersonChip_Click"
                                               Padding="6,4"
                                               CornerRadius="14"
                                               Background="{ThemeResource LayerFillColorDefaultBrush}"
                                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                               ToolTipService.ToolTip="Remove person">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Width="20" Height="20"
                                                            Fill="{x:Bind ColorBrush}"/>
                                                    <TextBlock Text="{x:Bind Initials}"
                                                              FontSize="9"
                                                              FontWeight="SemiBold"
                                                              Foreground="White"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{x:Bind Name}"
                                                          VerticalAlignment="Center"/>
                                                <Border Visibility="{x:Bind IsNew, Converter={StaticResource BoolToVisibilityConverter}}"
                                                       Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                       CornerRadius="8"
                                                       Padding="5,1"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="new"
                                                              FontSize="10"
                                                              Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
                                                </Border>
                                                <FontIcon Glyph="&#xE711;"
                                                         FontSize="10"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>

                    <!-- Photos: staged for a NEW event (attached right after the
                         save creates the event id); attached immediately when
                         editing an EXISTING event. Also a drop target. -->
                    <StackPanel Spacing="8"
                               Background="Transparent"
                               AllowDrop="True"
                               DragOver="MediaDropTarget_DragOver"
                               Drop="EventDialogPhotos_Drop">
                        <TextBlock Text="Photos" FontWeight="SemiBold"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Add photos..."
                                   Click="EventDialogAddPhotos_Click"/>
                            <TextBlock Text="{x:Bind ViewModel.DialogPendingPhotosLabel, Mode=OneWay}"
                                      VerticalAlignment="Center"
                                      FontSize="12"
                                      Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                        </StackPanel>
                        <TextBlock Text="You can also drop image files here."
                                  FontSize="11"
                                  Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"/>
                    </StackPanel>

                    <!-- Tags editor: suggestions from existing tags; free text allowed. -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Tags" FontWeight="SemiBold"/>
                        <AutoSuggestBox x:Name="TagSuggestBox"
                                       PlaceholderText="Add a tag"
                                       QueryIcon="Add"
                                       TextChanged="TagSuggestBox_TextChanged"
                                       SuggestionChosen="TagSuggestBox_SuggestionChosen"
                                       QuerySubmitted="TagSuggestBox_QuerySubmitted"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                     VerticalScrollBarVisibility="Disabled"
                                     HorizontalScrollMode="Enabled">
                            <ItemsControl ItemsSource="{x:Bind ViewModel.DialogTags, Mode=OneWay}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EventTagChipDto">
                                        <Button Click="TagChip_Click"
                                               Padding="6,4"
                                               CornerRadius="14"
                                               Background="{ThemeResource LayerFillColorDefaultBrush}"
                                               BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                               ToolTipService.ToolTip="Remove tag">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE8EC;"
                                                         FontSize="12"
                                                         VerticalAlignment="Center"/>
                                                <TextBlock Text="{x:Bind Name}"
                                                          VerticalAlignment="Center"/>
                                                <FontIcon Glyph="&#xE711;"
                                                         FontSize="10"
                                                         VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <!-- Delete confirmation dialog -->
        <ContentDialog x:Name="DeleteConfirmDialog"
                      Title="Delete Event"
                      Content="Are you sure you want to delete this event? This action cannot be undone."
                      PrimaryButtonText="Delete"
                      CloseButtonText="Cancel"
                      DefaultButton="Close"/>

        <!-- Go to Date dialog -->
        <ContentDialog x:Name="GoToDateDialog"
                      Title="Go to Date"
                      PrimaryButtonText="Go"
                      CloseButtonText="Cancel"
                      DefaultButton="Primary"
                      PrimaryButtonClick="GoToDateDialog_PrimaryButtonClick">
            <StackPanel Spacing="16" MinWidth="300">
                <TextBox x:Name="GoToDateTextBox"
                        Header="Enter date (mmddyy) or year (yyyy)"
                        PlaceholderText="e.g., 010190 or 1990"
                        KeyDown="GoToDateTextBox_KeyDown"/>
                <TextBlock x:Name="GoToDateHint"
                          Text="Tip: Enter just a year (e.g., 2006) to show that year centered with surrounding years"
                          FontSize="12"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </ContentDialog>

        <!-- Media lightbox: full image, prev/next, caption editing, and a
             two-step Remove (the secondary button arms, then confirms). -->
        <ContentDialog x:Name="MediaLightboxDialog"
                      Title="Photo"
                      PrimaryButtonText="Save caption"
                      SecondaryButtonText="Remove"
                      CloseButtonText="Close"
                      DefaultButton="Close"
                      PrimaryButtonClick="MediaLightbox_PrimaryButtonClick"
                      SecondaryButtonClick="MediaLightbox_SecondaryButtonClick">
            <StackPanel Spacing="10" MinWidth="420">
                <Grid MinHeight="240">
                    <Image x:Name="LightboxImage"
                          MaxWidth="620"
                          MaxHeight="400"
                          Stretch="Uniform"/>
                    <StackPanel x:Name="LightboxFilePlaceholder"
                               Visibility="Collapsed"
                               Spacing="8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <FontIcon x:Name="LightboxFileGlyph"
                                 Glyph="&#xE8A5;"
                                 FontSize="48"
                                 HorizontalAlignment="Center"/>
                        <TextBlock x:Name="LightboxFileName"
                                  HorizontalAlignment="Center"
                                  TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
                <Grid>
                    <Button x:Name="LightboxPrevButton"
                           Content="&#xE76B;"
                           FontFamily="Segoe MDL2 Assets"
                           AutomationProperties.Name="Previous photo"
                           ToolTipService.ToolTip="Previous"
                           HorizontalAlignment="Left"
                           Click="LightboxPrev_Click"/>
                    <TextBlock x:Name="LightboxCounter"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                    <Button x:Name="LightboxNextButton"
                           Content="&#xE76C;"
                           FontFamily="Segoe MDL2 Assets"
                           AutomationProperties.Name="Next photo"
                           ToolTipService.ToolTip="Next"
                           HorizontalAlignment="Right"
                           Click="LightboxNext_Click"/>
                </Grid>
                <TextBox x:Name="LightboxCaptionBox"
                        Header="Caption"
                        PlaceholderText="Add a caption (optional)"
                        MaxLength="500"/>
                <TextBlock x:Name="LightboxStatusText"
                          FontSize="12"
                          Foreground="{ThemeResource SystemControlForegroundBaseMediumBrush}"
                          TextWrapping="Wrap"/>
            </StackPanel>
        </ContentDialog>
    </Grid>
</UserControl>
