<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Compile against the Windows 11 24H2 SDK (10.0.26100); run on Windows 11
         22H2 or later. The .NET 10 SDK ships a matching Windows SDK projection
         for this platform version, so no WindowsSdkPackageVersion pin is needed.
         .NET 10 (not 8) is required by the Windows App SDK: its CsWinRT
         projections are built against a newer runtime, and consuming them from
         net8.0 fails with CS1705 assembly-version conflicts. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22621.0</TargetPlatformMinVersion>
    <RootNamespace>MemoryTimeline</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <!-- No PublishProfile: the template's win-$(Platform).pubxml was never added
         (there is no Properties/PublishProfiles folder). The app is distributed
         unpackaged from the build output; see DEVELOPMENT-STATUS.md on MSIX. -->
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12.0</LangVersion>

    <!-- Enable unpackaged (non-MSIX) deployment for direct .exe execution -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Use custom Program.cs entry point -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <StartupObject>MemoryTimeline.Program</StartupObject>
  </PropertyGroup>

  <!-- Assets\ does not exist yet (no app icons/tiles have been produced), so this
       glob matches nothing today; Package.appxmanifest still references the
       standard Assets\*.png names for a future MSIX build. -->
  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.3.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Whisper.net" Version="1.5.0" />
    <PackageReference Include="Whisper.net.Runtime" Version="1.5.0" />
    <!-- DPAPI (ProtectedData) for secrets at rest in app_settings; see
         Services/DpapiSecretProtector.cs. Windows-only, which is why it is
         referenced here and not in Core. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MemoryTimeline.Core\MemoryTimeline.Core.csproj" />
    <ProjectReference Include="..\MemoryTimeline.Data\MemoryTimeline.Data.csproj" />
    <ProjectReference Include="..\MemoryTimeline.Sync\MemoryTimeline.Sync.csproj" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>
</Project>
